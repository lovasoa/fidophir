+    /// Verify the decrypted candidate after the core durably charges a PIN retry.
+    fn verify_pin(&mut self, candidate: &[u8; 16]) -> CtapResult<bool> {
+        use subtle::ConstantTimeEq;
+        let stored = self
+            .persist()
+            .pin_hash()?
+            .ok_or(Ctap2StatusCode::CTAP2_ERR_PIN_NOT_SET)?;
+        let stored = self.key_store().decrypt_pin_hash(&stored)?;
+        Ok(bool::from(stored.as_slice().ct_eq(candidate)))
+    }
