# Install as /usr/lib/udev/rules.d/72-fidophir.rules.
# Runs after 70-uaccess, before 73-seat-late applies ACLs.
# Only the dedicated service receives UHID creation access.
SUBSYSTEM=="misc", KERNEL=="uhid", OWNER="root", GROUP="fidophir", MODE="0660", TAG-="uaccess"

# Only Fidophir can create this virtual device (UHID is service-only).
# Its unique ID is the user's numeric UID. Never grant access via uaccess:
# ACL revocation at logout cannot revoke an already-open hidraw descriptor.
SUBSYSTEM=="hidraw", KERNELS=="0006:0000:0001.*", IMPORT{parent}="HID_*"
SUBSYSTEM=="hidraw", KERNELS=="0006:0000:0001.*", ENV{HID_PHYS}=="fidophir-v2", ENV{HID_UNIQ}=="?*", OWNER:="$env{HID_UNIQ}", GROUP:="root", MODE:="0600", SYMLINK+="fidophir-$env{HID_UNIQ}", TAG-="uaccess"
