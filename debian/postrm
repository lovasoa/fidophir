#!/bin/sh
set -e
case "$1" in
    remove|purge)
        if [ -d /run/systemd/system ]; then
            udevadm control --reload-rules || true
            udevadm trigger --settle --action=change --subsystem-match=misc --sysname-match=uhid || true
            if [ "$(stat -c '%G' /dev/uhid 2>/dev/null)" = fidophir ]; then
                chmod 0600 /dev/uhid && chgrp root /dev/uhid || true
            fi
        fi
        ;;
esac
#DEBHELPER#
